# Copy to `deploy/.env` on the server, fill in, and `chmod 600` it.
#
# ENV=production, ADDR=:8081 and TRUST_PROXY_HEADERS=1 are baked into the
# image as facts about the deployment — do not set them here. Everything below
# is a secret, which is why it is a file on the box and not in the repo.

# Used by both Postgres (as POSTGRES_PASSWORD) and the app (inside
# DATABASE_URL). Generate with: openssl rand -hex 24
#
# Hex, not base64: this value is pasted into a URL, and base64 emits `+`, `/`
# and `=`. A `/` terminates the URL's authority section, so the app ends up
# looking for a host named after half your password. Percent-encoding would
# also work and is one more thing to get wrong.
#
# Changing it later takes more than editing this file: Postgres reads
# POSTGRES_PASSWORD only when it initialises its data directory, so an existing
# volume keeps the old one until you either ALTER USER or recreate it.
POSTGRES_PASSWORD=

# `postgres` is the compose service name. sslmode=disable is correct here and
# only here: the connection never leaves the Docker bridge network. The
# password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://pomodorus:CHANGEME@postgres:5432/pomodorus?sslmode=disable

# Liara's managed email server, kept from the previous deployment. It is a
# relay; it does not care which host the app runs on.
#
# Port 587, never 465. The mailer is net/smtp.SendMail, which opens a plain
# connection and upgrades it with STARTTLS; 465 is implicit TLS from the first
# byte, and against it the client hangs and then fails.
SMTP_HOST=smtp.c1.liara.email
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Pomodorus <no-reply@yourdomain>

# Permanent. If you are keeping the same domain, reuse the keypair from the
# previous deployment: a new one silently invalidates every push subscription
# any browser has ever handed over, and no browser can be told. Only generate
# a fresh pair (`make vapid`) for a genuinely new origin.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain

# FAST_SESSIONS is never set here. The server refuses to boot with it while
# ENV=production, which is the point.
