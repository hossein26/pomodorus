# TLS, HTTP/3 and compression in front of the one binary. Caddy obtains and
# renews the certificate itself; there is no certbot and no cron for it.
#
# Replace both placeholders before the first boot.
{
	# Let's Encrypt uses this to warn you before an expiry it could not renew.
	email you@example.com
}

pomodorus.example.com {
	# The binary sets Cache-Control but never compresses; this is where the JS
	# bundle stops being 400 KB on a phone.
	encode zstd gzip

	reverse_proxy app:8081

	# There is deliberately no `header_up X-Forwarded-For` here.
	#
	# TRUST_PROXY_HEADERS=1 is baked into the image, and the server reads
	# X-Forwarded-For counting TRUSTED_PROXY_HOPS back from the *right* to pick
	# a rate-limit bucket (server/internal/httpapi/auth.go). The default is one
	# hop, which is this file: Caddy is the only thing between the caller and
	# the app, so the rightmost entry is the one Caddy wrote and it is the real
	# peer address. Same for X-Forwarded-Proto, which decides the Secure flag on
	# the session cookie.
	#
	# Counting from the right rather than the left is what makes this safe
	# without having to prove what the proxy does with an incoming header. Caddy
	# happens to discard whatever the client sent — an incoming X-Forwarded-For
	# is preserved only from a peer listed in `trusted_proxies`, and that list
	# is empty — but a proxy that appended instead would still be read
	# correctly, because the caller can only ever add entries to the left.
	#
	# PUTTING A CDN IN FRONT (Cloudflare, ArvanCloud) ADDS A HOP. Then the peer
	# is the CDN, and the caller's own address is the second entry from the
	# right rather than the first. Two changes, both required:
	#
	#   1. Set TRUSTED_PROXY_HOPS=2 on the app.
	#   2. Tell Caddy to keep what the CDN forwarded rather than overwrite it:
	#
	#        reverse_proxy app:8081 {
	#            trusted_proxies static 1.2.3.0/24 2.3.4.0/24   # the CDN's ranges
	#        }
	#
	# List only the CDN's published ranges. `trusted_proxies static 0.0.0.0/0`
	# trusts everyone, which is the per-host limit not existing at all. Doing
	# (1) without (2) is worse than neither: Caddy would collapse the chain to
	# one entry, the count would reach past the end of it, and the server would
	# fall back to the CDN edge's address for everybody.

	# The WebSocket needs no configuration: Caddy proxies Upgrade natively and
	# the http transport has no read or write timeout by default, so a socket
	# held open across a 25-minute pomodoro is not cut.
}
